{
  "name": "cinevault-backend",
  "version": "1.0.0",
  "description": "CineVault streaming backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db:init": "node -e \"require('./config/database').initSchema().then(()=>{console.log('schema ready');process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})\"",
    "db:seed": "node -e \"require('./services/seed').seedDatabase().then(()=>{console.log('seed done');process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "engines": {
    "node": ">=18"
  }
}